# Every ITCS_* setting with its default from smart-traffic-backend/app/config.py.
# All are optional. For a local run, `set -a; . ./.env; set +a` before uvicorn;
# with Docker, put overrides under `environment:` in docker-compose.yml.

# production refuses ITCS_DETECTOR=stub; development and test allow it.
ITCS_ENV=production
# auto | yolo | coco | stub. auto uses ITCS_WEIGHTS_PATH when it exists, else coco.
ITCS_DETECTOR=auto
# Your own single-class YOLOv8 ambulance checkpoint (class 0 = ambulance).
ITCS_WEIGHTS_PATH=weights/best.pt
ITCS_PUBLIC_MODEL=yolov8n.pt
ITCS_MODEL_CACHE_DIR=weights
ITCS_COCO_EMERGENCY_CLASSES=truck,bus

ITCS_CONFIDENCE_THRESHOLD=0.75
ITCS_MIN_FRAMES_WITH_AMBULANCE=1
ITCS_MAX_FRAMES=100
ITCS_FRAME_STRIDE=1
ITCS_BATCH_SIZE=8
ITCS_IMAGE_SIZE=640
ITCS_DEVICE=auto

ITCS_MAX_CONCURRENT_INFERENCES=2
ITCS_INFERENCE_QUEUE_SLOTS=8
ITCS_MAX_UPLOAD_BYTES=67108864
ITCS_ALLOWED_ORIGINS=http://localhost:5173

ITCS_RETURN_FRAME=true
ITCS_MAX_FRAME_EDGE=1280
ITCS_JPEG_QUALITY=85

ITCS_PRIORITY_MIN_CONFIDENCE=0.80
ITCS_PRIORITY_CORROBORATING_SIGHTINGS=2
ITCS_PRIORITY_CORROBORATION_WINDOW_S=10.0
ITCS_PRIORITY_MIN_HOLD_S=8.0
ITCS_PRIORITY_MAX_HOLD_S=45.0
ITCS_PRIORITY_CLEAR_AFTER_S=6.0
ITCS_PRIORITY_COOLDOWN_S=20.0

ITCS_LOG_LEVEL=INFO
